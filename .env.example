# ════════════════════════════════════════════════════════════════════════════
# ProjectAssure — MAIN APP environment template
# Copy to `.env` for local runs, or add these in Vercel → Settings → Environment
# Variables. EVERY key is optional: with none set, the app runs fully on its
# built-in engine and demo data (jury-safe, offline).
#
# YOUR CURRENT VERCEL SETUP (from screenshot):
#   ✅ HOST_ADMIN_EMAIL          ✅ HOST_ADMIN_PASSWORD
#   ✅ DATABASE_URL              ✅ DIRECT_URL
#   ✅ NEXTAUTH_URL              ✅ NEXTAUTH_SECRET
#   ✅ EMAIL_USER                ✅ EMAIL_PASS
#   ✅ GEMINI_API_KEY            ✅ BREVO_API_KEY
#   ✅ SMTP_HOST                 ✅ SMTP_PORT
#   ✅ UPSTASH_REDIS_REST_URL    ✅ UPSTASH_REDIS_REST_TOKEN
#   ✅ PINECONE_API_KEY
#   ✅ BLOB_WEBHOOK_PUBLIC_KEY   ✅ BLOB_STORE_ID   ✅ BLOB_READ_WRITE_TOKEN
#
# NEW v23 VARS TO ADD (for forgot-password + cross-device accounts):
#   ➕ NEXT_PUBLIC_APP_URL  = https://project-assure.vercel.app
#      (used by /api/auth/request-reset to build the reset link in the email.
#       If you already have NEXTAUTH_URL set, the route falls back to it
#       automatically — but setting NEXT_PUBLIC_APP_URL explicitly is
#       recommended because it's also exposed to the client bundle.)
#   ➕ NEXT_PUBLIC_HOST_URL  = https://project-assure-host.vercel.app
#      (the host-control deployment URL — used by the landing page footer
#       "Host Control" button to deep-link to the host panels)
#   ➕ SYNC_TOKEN            = <any random string>
#      (shared secret between main app and host-control; when set, the
#       host-control webhook posts must include the header x-sync-token
#       with the same value. Optional but recommended for production.)
# ════════════════════════════════════════════════════════════════════════════

# ── 1 · LIVE INTELLIGENCE (pick any ONE; more = automatic fallback chain) ──
# Priority order if several are set: Gemini → Groq → OpenRouter → OpenAI.
#
# GEMINI (recommended — FREE): https://aistudio.google.com/apikey
#   Create API key → paste below. Free limits ≈ 15 req/min, 1,500/day.
#   Accepted aliases: GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=
#
# GROQ (FREE fallback — very fast): https://console.groq.com/keys
GROQ_API_KEY=
#
# OPENROUTER (FREE community models): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
#
# OPENAI (paid fallback): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 2 · DATABASE (REQUIRED for cross-device account persistence) ───────────
# WITHOUT DATABASE_URL, registered accounts are stored in the browser's
# localStorage only — they do NOT survive a cache clear or transfer to
# another device. With DATABASE_URL set + `npx prisma db push` run, accounts
# persist in the Postgres database and sync to every browser on boot.
#
# Neon free tier: https://neon.tech → copy the pooled connection string.
# Supabase free tier: https://supabase.com → copy the connection string.
#
# DATABASE_URL  — pooled connection (used at runtime, ?pgbouncer=true)
# DIRECT_URL    — direct connection (used by Prisma migrate/db push)
#
# After setting these, run ONCE:
#   npx prisma db push
# This creates all tables including the v23 PasswordResetToken table.
#
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── 3 · NEXTAUTH (auth session secrets) ────────────────────────────────────
# NEXTAUTH_URL   — the public URL of this deployment (e.g. https://project-assure.vercel.app)
# NEXTAUTH_SECRET — random 32-byte hex string (openssl rand -base64 32)
#
# NEXTAUTH_URL=https://project-assure.vercel.app
# NEXTAUTH_SECRET=

# ── 4 · EMAIL DELIVERY (optional — real outbound email) ────────────────────
# Any ONE of these three enables the Email Centre to actually send:
#   a) EMAIL_USER + EMAIL_PASS  — Gmail App Password (or any SMTP login)
#   b) BREVO_API_KEY            — https://app.brevo.com (300/day free)
#   c) RESEND_API_KEY           — https://resend.com (3,000/month free)
#
# The forgot-password flow uses these to email the reset link.
# If no provider is configured, the reset link is audit-logged (deliver
# manually) — the flow still works, just no email goes out.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
BREVO_API_KEY=
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# ── 5 · HOST CONTROL BRIDGE (v21 sync hub) ────────────────────────────────
# The main app mirrors its live state to the Host Control platform via
# /api/sync/*. The host-control polls /api/sync/state every 5s.
#
# NEXT_PUBLIC_HOST_URL — the host-control deployment URL (shown in the
#   landing page footer "Host Control" button + dropdown)
# SYNC_TOKEN — optional shared secret; when set, host-control must send
#   the same value in the x-sync-token header for webhook posts.
#
# NEXT_PUBLIC_HOST_URL=https://project-assure-host.vercel.app
# SYNC_TOKEN=

# ── 6 · v23 PASSWORD RESET (uses NEXTAUTH_URL as fallback) ────────────────
# The /api/auth/request-reset route builds the reset link as:
#   ${NEXT_PUBLIC_APP_URL || NEXTAUTH_URL}/#/reset?token=<token>
#
# If you already have NEXTAUTH_URL set (which you do), you do NOT need to
# add NEXT_PUBLIC_APP_URL — the route falls back to NEXTAUTH_URL.
# But setting it explicitly is recommended for clarity.
#
# NEXT_PUBLIC_APP_URL=https://project-assure.vercel.app

# ── 7 · HOST ADMIN CREDENTIALS (for the host-control bridge) ──────────────
# These are used by the host-control's login route (it shares the same
# database). Set them to the same values on both Vercel projects.
# HOST_ADMIN_EMAIL=cpo@mospi.gov.in
# HOST_ADMIN_PASSWORD=hostoverseer

# ── 8 · OPTIONAL INFRASTRUCTURE (Redis, Pinecone, Vercel Blob) ────────────
# These are optional enhancements — the app works without them.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PINECONE_API_KEY=
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=
