// ProjectAssure Host Control — Prisma schema
// Minimal schema (no database required for the demo, but `prisma generate`
// must succeed during `npm install` on Vercel). In production you would
// connect this to Neon Postgres by setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  String
}
