// ProjectAssure Host Control — PostgreSQL (production / Neon)
// Set DATABASE_URL and the host store persists across deployments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  String
}

// v23: host-control state persistence (approvals, audit, outbox, mirror)
// — survives serverless cold starts when DATABASE_URL is configured.
model HostState {
  id        String   @id @default("singleton")
  stateJson String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
