// ProjectAssure Host Control — SQLite (local dev)
// With DATABASE_URL unset the host store persists to .host-store.json only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  String
}

// v23: host-control state persistence (approvals, audit, outbox, mirror)
// — survives serverless cold starts when DATABASE_URL is configured.
model HostState {
  id        String   @id @default("singleton")
  stateJson String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
