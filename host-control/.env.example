# ─── ProjectAssure Host Control — environment template ───────────────────────
# Copy to .env.local and fill in. All keys are OPTIONAL — the app runs in
# built-in engine mode without them. See README.md §Configuration.

# URL of the MAIN ProjectAssure prototype this host-control talks to.
# Used by the Integrations panel + sync polling + Demo Showcase links.
MAIN_PROJECT_URL=https://project-assure.vercel.app

# Intelligence provider chain — first working key serves the answer.
# 1) Gemini (free, Google AI Studio) — recommended
GEMINI_API_KEY=
# alt name accepted by the code:
# GOOGLE_API_KEY=

# 2) Groq (free, OpenAI-compatible)
GROQ_API_KEY=

# 3) OpenRouter (free community models)
OPENROUTER_API_KEY=

# 4) OpenAI (paid fallback)
OPENAI_API_KEY=

# Optional: secret token that the main project must send when POSTing events
# to this host-control's inbound webhook (/api/admin/sync).
# WEBHOOK_SECRET=

# Optional: SQLite database (only used by the empty Prisma schema — not required
# for the demo, the app is in-memory + localStorage).
DATABASE_URL="file:./dev.db"
