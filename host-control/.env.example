# ═══════════════════════════════════════════════════════════════════════════
# ProjectAssure Host Control — environment variables
# Copy to .env.local (dev) or set in Vercel project settings.
# Every variable is OPTIONAL except the ones you want to change from defaults.
#
# YOUR CURRENT VERCEL SETUP (from screenshot):
#   ✅ HOST_ADMIN_EMAIL          ✅ HOST_ADMIN_PASSWORD
#   ✅ GEMINI_API_KEY            ✅ OPENROUTER_API_KEY
#   ✅ EMAIL_USER                ✅ EMAIL_PASS
#   ✅ SMTP_HOST                 ✅ SMTP_PORT
#   ✅ BREVO_API_KEY             ✅ RESEND_API_KEY
#   ✅ ALERT_EMAIL_FROM          ✅ MAIN_PROJECT_URL
#
# ALL 12 variables are set — you're fully configured! No new env vars needed
# for the v23 features. The host-control's v23 additions (Settings panel,
# reject-with-action approvals, honest AI probe, integrations persistence
# note) all use the existing env vars.
#
# OPTIONAL ADDITIONS (not required, but recommended for production):
#   ➕ SYNC_TOKEN            = <same random string as the main app>
#      (shared secret for host→main webhook posts. When set on BOTH projects,
#       the main app's /api/sync/webhook rejects posts without the
#       x-sync-token header. Optional but recommended for production.)
#   ➕ HOST_SESSION_SECRET   = <random 16+ char string>
#      (session cookie signing secret; when unset, derived from
#       HOST_ADMIN_PASSWORD — changing the password invalidates all sessions)
#   ➕ GROQ_API_KEY          = <free key from console.groq.com>
#      (second AI provider — Gemini → Groq → sandbox SDK → built-in engine.
#       The Intelligence Console badge shows "live" when any provider
#       actually answers the probe.)
# ═══════════════════════════════════════════════════════════════════════════

# ── Main app bridge (REQUIRED in production) ────────────────────────────────
# Where the sync engine polls /api/sync/state and posts /api/sync/webhook.
# Dev default: http://localhost:3000 (the main app's port).
# Production: https://project-assure.vercel.app
MAIN_PROJECT_URL=http://localhost:3000

# Optional shared secret. When set:
#  · host → main webhook posts send header  x-sync-token: <value>
#  · main  → host direct pushes (POST /api/admin/sync) must send the same
# Must match the main app's SYNC_TOKEN if both are set.
SYNC_TOKEN=

# ── Host administrator login (CHANGE THE DEFAULTS in production) ───────────
# These are the credentials for the host-control admin login.
# The same values must be set on the MAIN app too (the host-control's
# /api/auth/login route checks these env vars first, then the stored hash
# from /api/admin/auth/change-password).
HOST_ADMIN_EMAIL=cpo@mospi.gov.in
HOST_ADMIN_PASSWORD=hostoverseer

# Optional session-signing secret (≥16 chars).
# When unset, one is derived from HOST_ADMIN_PASSWORD — changing the password
# then invalidates every live session.
HOST_SESSION_SECRET=

# ── Intelligence Console (optional, first working one serves) ───────────────
# The /api/ai/status route PROBES each provider (not just checks the env var)
# before reporting it as "ready". The badge shows "live · <provider>" only
# when at least one provider actually answered the probe.
#
# Gemini: free key from Google AI Studio
GEMINI_API_KEY=
# Groq: free key from console.groq.com
GROQ_API_KEY=
# OpenRouter: free community models
OPENROUTER_API_KEY=
# (no keys → the built-in deterministic engine answers from the live mirror,
#  honestly labeled as "deterministic engine")

# ── Automated email alerts (optional, first working provider serves) ────────
# The host-control sends these automated emails:
#   · login alerts (when a user logs in)
#   · budget breach alerts (when a project exceeds the threshold)
#   · welcome emails (when a new registered user appears)
#   · disband emails (v23 — when an account is rejected via "disband account")
#
# Option A — SMTP (Gmail App Password or any relay):
#   2FA must be enabled; generate an App Password, paste WITHOUT spaces.
#   port 465 → implicit TLS · port 587 → STARTTLS
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Option B — Brevo HTTP API (free 300/day): BREVO_API_KEY=
BREVO_API_KEY=
# Option C — Resend HTTP API: RESEND_API_KEY=
RESEND_API_KEY=
# Verified sender for Brevo/Resend (required on those platforms)
ALERT_EMAIL_FROM=
# (no provider → emails are recorded honestly as SIMULATED in the Outbox)
