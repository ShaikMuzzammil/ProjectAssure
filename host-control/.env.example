# ProjectAssure Host Control — Environment Variables
# Copy to .env.local and fill in your values.

# Intelligence provider chain (all optional — first working one serves answers)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# The URL of your deployed main ProjectAssure prototype.
# The host-control polls this URL's /api/health every 5 seconds.
MAIN_PROJECT_URL=https://project-assure.vercel.app
